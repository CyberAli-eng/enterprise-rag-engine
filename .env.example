# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it is already in .gitignore.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated API keys clients must send as the X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=change-me-generate-a-real-key
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# LLM provider: openai | groq | together | ollama
# Free & local: set LLM_PROVIDER=ollama, LLM_MODEL=llama3.2:3b and
# OLLAMA_BASE_URL=http://ollama:11434/v1, then run
# `docker compose --profile local up --build` (no API key needed).
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=your-provider-api-key-here
OPENAI_API_BASE=
LLM_TEMPERATURE=0
# Only used when LLM_PROVIDER=ollama (inside docker compose: http://ollama:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Embeddings: local (free, on-box) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector store: chroma (local/free) | pinecone (managed/cloud)
VECTOR_STORE=chroma
PINECONE_API_KEY=
PINECONE_INDEX=enterprise-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=enterprise_docs

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5
